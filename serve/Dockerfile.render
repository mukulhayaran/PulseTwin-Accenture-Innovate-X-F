# Trimmed backend image for a free-tier host (Render). Serves /supervisor, /manager,
# /leadership, /ops read-only panels, and plant_a/plant_b swap off the committed SQLite
# artifact -- the walkthrough in docs/DEMO_SCRIPT.md. Does NOT include the GenAI copilot
# or MLOps retrain-trigger subprocess jobs (openai/pandas/scipy/scikit-learn and the
# genai/mlops/offline packages they need), which serve/routers/{triage,admin}.py both
# refuse with a clean 503 when PULSETWIN_JOBS_ENABLED=0 -- see those files. This is a
# SEPARATE file from serve/Dockerfile on purpose: that one is still what
# docker-compose.prod.yml builds for the full finals stack (MQTT dropout demo, retrain,
# copilot) and must keep working unmodified.
FROM python:3.11-slim
WORKDIR /app

COPY serve/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY serve/ ./serve/
COPY artifacts/ ./artifacts/
# Only the plant YAMLs, not genai/mlops/offline/migrations/feature_contract.py: admin.py
# and triage.py both check configs/<plant>.yaml exists before doing anything else, so
# this alone keeps the plant-selection UI and its 404 path behaving normally.
COPY configs/ ./configs/

ENV PULSETWIN_JOBS_ENABLED=0
EXPOSE 7860
# Render sets $PORT at runtime and routes traffic there; it is not always 7860. Shell form
# so the variable expands, with 7860 as the local/manual-run fallback.
CMD uvicorn serve.main:app --host 0.0.0.0 --port ${PORT:-7860} --workers 1
