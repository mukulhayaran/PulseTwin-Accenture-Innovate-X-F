{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "infrastructure/monitoring/prometheus.yml's pulsetwin-backend scrape job",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "PulseTwin — Overview",
  "uid": "pulsetwin-overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["pulsetwin", "finals-brief-F5"],
  "panels": [
    {
      "id": 1,
      "title": "Predictions / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (plant_id) (rate(pulsetwin_predictions_total[5m]))",
          "legendFormat": "{{plant_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prediction latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, plant_id) (rate(pulsetwin_prediction_latency_seconds_bucket[5m])))",
          "legendFormat": "{{plant_id}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alerts fired / shift",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (plant_id, shift) (increase(pulsetwin_alerts_fired_total[8h]))",
          "legendFormat": "{{plant_id}} / {{shift}}"
        }
      ],
      "description": "Compare against configs/economics.yaml's alarm_budget.max_alerts_per_shift (6) -- consistently over budget means the operating threshold needs revisiting, not that this panel is wrong."
    },
    {
      "id": 4,
      "title": "Drift PSI by feature",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pulsetwin_drift_psi",
          "legendFormat": "{{plant_id}} / {{feature}}"
        }
      ],
      "description": "mlops/drift_detector.py's PSI thresholds: <0.1 healthy, 0.1-0.2 warning, >0.2 significant shift."
    },
    {
      "id": 5,
      "title": "Sensor dropouts active",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "thresholds": {
        "mode": "absolute",
        "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
      } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(pulsetwin_sensor_dropouts_active)"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ingestion lag (s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "thresholds": {
        "mode": "absolute",
        "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 5 }]
      } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pulsetwin_ingestion_lag_seconds",
          "legendFormat": "{{plant_id}}"
        }
      ],
      "description": "serve/routers/system.py's own threshold_s: 5.0 -- kept identical here rather than a second, driftable number."
    },
    {
      "id": 7,
      "title": "Active SSE connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pulsetwin_active_connections"
        }
      ]
    },
    {
      "id": 8,
      "title": "HTTP request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (handler, status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{handler}} [{{status}}]"
        }
      ],
      "description": "Generic request-count/latency series added by prometheus-fastapi-instrumentator (serve/main.py) alongside the pulsetwin_* series above -- one scrape target, two metric families."
    }
  ]
}
