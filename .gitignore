__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

node_modules/
.next/
out/

data/
artifacts/ 

.DS_Store
*.log

# Provider credentials. GROQ_API_KEY is read from the environment only
# (docs/SECURITY.md); this keeps a local key file from ever becoming committable.
.env
.env.*
!.env.example
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo


# Real-dataset benchmark subsystem (ADR pending, docs/benchmarking.md): raw downloads and
# Parquet caches never committed, matching artifacts/'s "commit derived output once, never
# raw bulk data" convention. tests/fixtures/*.csv (small, curated) are NOT covered by this
# and stay tracked.

# Engineering loop (LOOP.md): goal.json is the stable contract and is committed; the rest
# of .loop/ is per-machine runtime state.
.loop/*
!.loop/goal.json
.neon

# Local scratch output (screenshots, PDFs, pytest temp dirs) -- never source.
tmp/

.vercel
.env*
