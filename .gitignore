__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

node_modules/
.next/
out/

data/
artifacts/ 

.DS_Store
*.log

# Provider credentials. GROQ_API_KEY is read from the environment only
# (docs/SECURITY.md); this keeps a local key file from ever becoming committable.
.env
.env.*
!.env.example
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo

# Markdown is not committed here -- README.md is the only exception.
# Note: this has no effect on the ~20 .md files already tracked (CLAUDE.md, docs/*.md);
# .gitignore never applies to files already in the index. Use `git rm --cached` for those.
*.md
!README.md

# Real-dataset benchmark subsystem (ADR pending, docs/benchmarking.md): raw downloads and
# Parquet caches never committed, matching artifacts/'s "commit derived output once, never
# raw bulk data" convention. tests/fixtures/*.csv (small, curated) are NOT covered by this
# and stay tracked.
